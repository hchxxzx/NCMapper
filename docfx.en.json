{
  // DocFX 英文站配置（2026-09-01 双语言拆分，docfx.zh.json / docfx.en.json）。
  // 架构：一个离线包 = 一种语言。英文站独立构建，仅含英文叙事 + 英文 API 参考，
  // 消除中英 API 参考同站的 uid 冲突（原单站方案 547 个 DuplicateUids）。
  //
  // API 口径（2026-09-01 统一为 dll 生成）：中英两语 API 都用「dll + 对应语言 XML」。
  // 英文用 dll+en XML（769 uid，含构造器/运算符/继承成员）。源由 scripts/prepare-api-src.sh
  // 组装（复制 Release/net8.0 dll + locales/en/NCMapper.xml → temp/en-api-src/），
  // 须在 docfx metadata 之前执行。
  //
  // 离网纯净（方案 §4.4）：
  //   1) xrefService 关闭 —— 禁止构建期联网拉取 xrefmap（构建零网络依赖）；
  //   2) metadata.disableGitFeatures —— 禁止按 clone origin 生成「Go to Source」git 外链；
  //   3) 外链清零 = scripts/strip-external-xref.sh（metadata 之后、build 之前）+ 审计兜底。
  "metadata": [
    {
      "src": [
        {
          "files": [ "temp/en-api-src/*.dll" ]
        }
      ],
      "dest": "docs/en-US/reference/api",
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        // 英文站只收录 en 叙事 + en API yml；zh-CN 完全不进入英文站构建。
        "files": [
          "docs/en-US/**/*.md",
          "docs/en-US/reference/api/**/*.yml",
          // 站点根导航 toc：docs/toc-en.md 为英文站 navbar（显式 toc 声明）
          // 2026-09-30：英文包只装 wiki 文档 + DEMO（samples），CONTRIBUTING.md（仓库级文件）移出
          // 2026-10-01：navbar 三件套（toc/index/配置）收拢——toc 与 index 移入 docs/，
          // 仅 docfx.<lang>.json 留仓库根（DocFX 的 ~ 基准绑定配置所在目录，无法下移）。
          "docs/toc-en.md"
        ],
        "toc": "docs/toc-en.md",
        "exclude": [
          // 原主技术文档单体（英文镜像若存在）：不入站点
          "docs/en-US/documentation/**",
          // wiki 镜像目录（若存在）：站点导航由 DocFX toc 承担
          "docs/en-US/wiki/**",
          // 含全站唯一外链（仓库主页自引用），零外链策略下排除
          "docs/en-US/reference/competitors.md",
          // wiki 侧边栏残留工件，与站点 toc 重复
          "docs/en-US/how-to/_Sidebar.md",
          // wiki 遗留首页：无扩展名链接在 DocFX 下全部 InvalidFileLink
          "docs/en-US/how-to/Home.md",
          // site-assets：英文站 raw 资产素材库（samples README 的英文版），属 overlay 类，
          // 由 scripts/prepare-en-site-sources.sh overlay 在 docfx build 之后直接覆盖站点产物，
          // 不经 docfx 内容构建；其内相对链接按最终落点（samples/ 目录）书写，在素材位置解析不到，
          // 若被 docs/en-US/**/*.md 通配纳入会误报 16 条 InvalidFileLink（2026-10-01）
          "docs/en-US/site-assets/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "docs/en-US/assets/**",
          // 站点根跳转页：源在 docs/（2026-10-01 起）。DocFX 按源路径拷贝为 <site>/docs/index-en.html，
          // 打包脚本 build-offline-docs.sh 再搬移到站点根 index.html（离线包默认文件要求）。
          // 页面内链接按「站点根」视角书写（docs/en-US/index.html），搬移后即正确。
          "docs/index-en.html",
          "LICENSE",
          // 2026-09-30：英文包只装 wiki 文档 + DEMO（samples），CHANGELOG.md（仓库级文件）移出
          "samples/NCMapper.AotSample/README.md",
          "samples/NCMapper.Samples/README.md",
          // 存量清零（与 docfx.zh.json 同步）：修至迁移后实态域目录。
          // 英文站：打包脚本（build-offline-docs.sh / CI docs.yml）在 docfx build 前用注释侧车
          // （docs/i18n/en/samples/.../*.cs.json，纯注释数据）注入英文注释版临时覆盖这两个
          // .cs（[!code-csharp] 构建时嵌入页面），build 后还原中文原版
          // （见 scripts/prepare-en-site-sources.sh + scripts/inject-demo-comments.ps1）。
          "samples/NCMapper.Samples/03-Compose/ComposeScenarios.cs",
          "samples/NCMapper.Samples/05-Orm/FreeSqlScenarios.cs",
          "src/NCMapper/MaskProvider.cs"
          // en 镜像单体与 zh 权威单体两条 resource 随工件物理删除移除
          //（en 存量指向单体链接按平移豁免登记）
        ]
      }
    ],
    "output": "temp/site-en",
    // 后处理器：生成站内搜索索引 index.json（lunr，模板 search-worker.min.js 消费）
    "postProcessors": [ "ExtractSearchIndex" ],
    // 模板：内置 default（classic）+ 自定义 templates/（B1 中文搜索修复；英文站同样可用）
    "template": [ "default", "templates" ],
    "globalMetadata": {
      "_appTitle": "NCMapper",
      "_appFooter": "<span>NCMapper Docs · Built with DocFX</span>",
      "_appBreadcrumbs": true,
      "_enableSearchEngine": true,
      "_lang": "en-US",
      // 零外链门禁：关闭 classic 模板 git-contribution 渲染的「Edit this page」外链按钮
      "_disableContribution": true
    },
    "xrefService": []
  }
}
